.hint { color: var(--color-text-secondary); font-size: var(--font-sm); padding: var(--space-3) 0; }
.section-title { font-size: var(--font-lg); font-weight: var(--font-semibold); margin-bottom: var(--space-3); }
.input {
  width: 100%;
  height: 44px;
  padding: 0 var(--space-3);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-2);
  font-size: var(--font-base);
}
.input.textarea { height: auto; min-height: 80px; padding: var(--space-3); }
.work-item { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
.work-item:last-child { border-bottom: none; }
.work-head { font-size: var(--font-base); font-weight: var(--font-medium); }
.work-period { font-size: var(--font-xs); color: var(--color-text-tertiary); margin: 2px 0 var(--space-2); }
.footer-action { padding: var(--space-6) 0; }